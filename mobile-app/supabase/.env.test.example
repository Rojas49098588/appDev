# TEST project settings. Copy to supabase/.env.test.local (git-ignored) and fill in
# from the TEST Supabase project, never the live one. Used by:
#   npm run db:apply:test   npm run db:check:test   npm run test:rls
# Project Settings -> API (or Data API): Project URL, ending at .supabase.co
SUPABASE_URL=
# Project Settings -> API Keys: the "anon" / "public" key
SUPABASE_ANON_KEY=
# Project Settings -> API Keys: the "service_role" / "secret" key
SUPABASE_SERVICE_ROLE_KEY=
# Connect (top of the dashboard) -> Session pooler connection string, with your DB password filled in
SUPABASE_DB_URL=
INVITE_CODE=4F2K9
