    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-network": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "pg": "^8.23.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:test": "node --env-file=.env.test.local node_modules/expo/bin/cli start --clear",
    "test": "node --test \"tests/*.test.ts\"",
    "test:members": "node --env-file=supabase/.env.test.local supabase/scripts/seed-test-members.mjs",
    "test:rls": "node --env-file=supabase/.env.test.local --test supabase/tests/rls.test.ts",
    "db:apply": "node --env-file=supabase/.env.local supabase/scripts/run-sql.mjs supabase/schema.sql supabase/seed.sql",
    "db:check": "node --env-file=supabase/.env.local supabase/scripts/run-sql.mjs --check",
    "db:apply:test": "node --env-file=supabase/.env.test.local supabase/scripts/run-sql.mjs supabase/schema.sql supabase/seed.sql supabase/test-seed.sql",
    "db:check:test": "node --env-file=supabase/.env.test.local supabase/scripts/run-sql.mjs --check"
  },
  "private": true
}
